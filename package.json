{
  "name": "react-storage-utils",
  "version": "2.0.1",
  "private": false,
  "type": "module",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rollup -c",
    "update-version": "node bump-version.js",
    "publish:all": "rollup -c && npm run update-version && git add . && git commit -m \"feat: update version and README\" && git push origin main && npm publish --access public",
    "demo": "node run-demo.js",
    "demo:open": "start demo-standalone.html",
    "demo:serve": "npx http-server . -p 3000 -o demo-standalone.html",
    "demo:react": "vite --config vite.config.js --port 1999",
    "demo:dev": "vite --config vite.config.js --port 1999"
  },
  "dependencies": {
    "crypto-js": "^4.2.0",
    "idb": "^5.0.6"
  },
  "peerDependencies": {
    "@fluentui/react": "^7.0.0 || ^8.0.0",
    "react": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.16.0",
    "@babel/preset-env": "^7.16.4",
    "@babel/preset-react": "^7.16.0",
    "@babel/preset-typescript": "^7.16.0",
    "@fluentui/react": "^7.0.0 || ^8.0.0",
    "@rollup/plugin-babel": "6.0.4",
    "@rollup/plugin-commonjs": "^21.0.1",
    "@rollup/plugin-json": "^6.0.0",
    "@rollup/plugin-node-resolve": "^13.0.6",
    "@rollup/plugin-typescript": "8.3.0",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^16.18.126",
    "@types/react": "^19.0.11",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.2.1",
    "@yelo/rollup-node-external": "^1.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rollup": "^2.60.0",
    "rollup-plugin-css-only": "^4.5.2",
    "rollup-plugin-dts": "^4.0.1",
    "rollup-plugin-peer-deps-external": "2.2.4",
    "rollup-plugin-postcss": "^4.0.1",
    "rollup-plugin-terser": "7.0.2",
    "rollup-plugin-typescript2": "0.36.0",
    "typescript": "^4.9.5",
